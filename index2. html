// NAVIGATION SYSTEM

const buttons = document.querySelectorAll(".nav-btn");
const pages = document.querySelectorAll(".page");

const titles = {
  overview:"Technology Intelligence Dashboard",
  trends:"Technology Trends Analysis",
  ai:"Artificial Intelligence Adoption",
  skills:"Technology Skills Analytics",
  careers:"Technology Career Insights",
  about:"About JAB-SAN TECH"
};

buttons.forEach(button => {

  button.addEventListener("click", () => {

    const target = button.dataset.page;

    buttons.forEach(item => item.classList.remove("active"));
    pages.forEach(page => page.classList.remove("active"));

    button.classList.add("active");

    document.getElementById(target).classList.add("active");

    document.getElementById("pageTitle").textContent = titles[target];

    window.scrollTo({
      top:0,
      behavior:"smooth"
    });

    setTimeout(() => {
      Object.values(charts).forEach(chart => {
        if(chart) chart.resize();
      });
    },100);

  });

});


// CHART CONFIGURATION

Chart.defaults.font.family = "Arial";
Chart.defaults.color = "#71809b";

const charts = {};

const chartColors = [
  "#315efb",
  "#17b8c8",
  "#8c73ef",
  "#f2b84b",
  "#9aa8bd"
];


// OVERVIEW LANGUAGE CHART

charts.language = new Chart(
  document.getElementById("languageChart"),
  {
    type:"bar",

    data:{
      labels:[
        "Python",
        "JavaScript",
        "SQL",
        "TypeScript",
        "Java",
        "C++"
      ],

      datasets:[{
        label:"Sample index",
        data:[90,82,76,68,55,44],
        backgroundColor:"#315efb",
        borderRadius:6
      }]
    },

    options:{
      responsive:true,
      maintainAspectRatio:false,

      plugins:{
        legend:{display:false}
      },

      scales:{
        y:{
          beginAtZero:true,
          max:100
        }
      }
    }
  }
);


// OVERVIEW AI CHART

charts.ai = new Chart(
  document.getElementById("aiChart"),
  {
    type:"doughnut",

    data:{
      labels:[
        "Code assistance",
        "Learning",
        "Writing",
        "Data analysis",
        "Other"
      ],

      datasets:[{
        data:[35,25,18,14,8],
        backgroundColor:chartColors,
        borderWidth:0
      }]
    },

    options:{
      responsive:true,
      maintainAspectRatio:false,

      plugins:{
        legend:{
          position:"bottom"
        }
      }
    }
  }
);


// TECHNOLOGY TREND CHART

charts.trend = new Chart(
  document.getElementById("trendChart"),
  {
    type:"line",

    data:{
      labels:[
        "Python",
        "JavaScript",
        "SQL",
        "TypeScript",
        "Java",
        "C++"
      ],

      datasets:[{
        label:"Sample interest index",
        data:[90,82,76,68,55,44],
        borderColor:"#315efb",
        backgroundColor:"rgba(49,94,251,0.12)",
        fill:true,
        tension:0.35
      }]
    },

    options:{
      responsive:true,
      maintainAspectRatio:false,

      scales:{
        y:{
          beginAtZero:true,
          max:100
        }
      }
    }
  }
);


// AI DETAILS CHART

charts.aiDetail = new Chart(
  document.getElementById("aiDetailChart"),
